# Server Configuration
EDITOR_API_PORT=8081

# Storage Backend
# Leave empty for in-memory storage (data lost on restart)
# Set to a file path for SQLite persistence
EDITOR_DB_PATH=./editor.db

# Intent Service (GPT-powered editing suggestions)
# Option 1: OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_ORG=

# Option 2: Custom AI Chat Service (e.g., local LLM)
AICHAT_BASE_URL=http://localhost:8080
AICHAT_MODEL=story-intent

# If none are set, intent service is disabled (manual entry only)
