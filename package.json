{
	"name": "incredible-studio",
	"version": "0.0.0",
	"private": true,
	"description": "Incredible Studio lives in studio/. These scripts run it from the repository root.",
	"scripts": {
		"setup": "yarn --cwd studio setup",
		"doctor": "yarn --cwd studio doctor",
		"dev": "yarn --cwd studio dev",
		"desktop": "yarn --cwd studio desktop",
		"start": "yarn --cwd studio start",
		"test": "yarn --cwd studio run check",
		"test:storage": "yarn --cwd studio run check:storage",
		"build": "yarn --cwd studio build"
	},
	"engines": {
		"node": ">=22"
	}
}
