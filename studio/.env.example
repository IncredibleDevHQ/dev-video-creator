# Local development (standalone files) or PostgreSQL + S3 deployed storage.
MINIMAL_STUDIO_PERSISTENCE=local
MINIMAL_STUDIO_DATA_DIR=.minimal-studio-data

# Set persistence to postgres-s3 and fill these on the server.
# MINIMAL_STUDIO_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# MINIMAL_STUDIO_S3_BUCKET=incredible-studio
# MINIMAL_STUDIO_S3_PREFIX=notebooks
# MINIMAL_STUDIO_S3_REGION=us-east-1

# MinIO or another S3-compatible service: full API endpoint URL.
# For AWS S3, omit endpoint and use AWS's standard regional endpoint.
# MINIMAL_STUDIO_S3_ENDPOINT=http://127.0.0.1:59000
# MINIMAL_STUDIO_S3_FORCE_PATH_STYLE=true

# Optional explicit credentials. If omitted, use the AWS credential chain
# (for example an IAM workload role). Never use VITE_ variables for keys.
# MINIMAL_STUDIO_S3_ACCESS_KEY_ID=
# MINIMAL_STUDIO_S3_SECRET_ACCESS_KEY=
# MINIMAL_STUDIO_S3_SESSION_TOKEN=

# Optional: with a Quiver key (https://quiver.ai), a scene's main actors are
# drawn as layered SVG artwork whose parts the animation moves. Without one,
# scenes are built as before.
# QUIVER_API_KEY=

# Optional: with a TypeSafe key (https://typesafe.ai), Jev suggests a
# notebook's template from its source and reads which beat each wireframe
# carries. Without one, the creator picks the template as before.
# TYPESAFE_API_KEY=

# Optional: your own developer apps, for signing in to your accounts from the
# studio (Release → Accounts). Register http://127.0.0.1:4320/api/accounts/
# <google|x|linkedin>/callback as each app's redirect. Without them, the
# client id and secret can be kept from the Accounts dialog instead.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
