{
  "name": "incredible-minimal-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "tsc --noEmit && vitest run",
    "build": "tsc --noEmit && vite build",
    "check:storage": "node checks/storage-check.mjs",
    "start": "node --env-file-if-exists=.env --import tsx engine/server.ts",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/setup.mjs",
    "desktop": "node scripts/desktop.mjs",
    "format": "prettier --write \"app/**/*.{ts,css}\" \"engine/**/*.ts\" \"shared/**/*.ts\" \"render/**/*.ts\" \"scripts/*.mjs\" \"checks/**/*.{ts,mjs}\" \"*.json\"",
    "format:check": "prettier --check \"app/**/*.{ts,css}\" \"engine/**/*.ts\" \"shared/**/*.ts\" \"render/**/*.ts\" \"scripts/*.mjs\" \"checks/**/*.{ts,mjs}\" \"*.json\" && node scripts/check-source-size.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "electron": "44.2.0",
    "prettier": "3.8.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@hyperframes/core": "0.7.106",
    "@hyperframes/producer": "0.7.106",
    "dompurify": "^3.4.16",
    "gsap": "3.12.5",
    "linkedom": "^0.18.12",
    "marked": "^18.0.14",
    "pg": "^8.23.0",
    "puppeteer": "25.12.0"
  },
  "packageManager": "yarn@1.22.22"
}
